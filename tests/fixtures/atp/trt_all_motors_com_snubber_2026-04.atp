MODEL SNUB_CTRL
COMMENT
  Controlador Master Trigger.
  Replica o disparo (latch) para todas as fases.
ENDCOMMENT

INPUT
  STA
  STB
  STC

OUTPUT
  GA_P
  GA_N
  GB_P
  GB_N
  GC_P
  GC_N

VAR
  FM
  GA_P
  GA_N
  GB_P
  GB_N
  GC_P
  GC_N

INIT
  FM   := 0.0
  GA_P := 0.0
  GA_N := 0.0
  GB_P := 0.0
  GB_N := 0.0
  GC_P := 0.0
  GC_N := 0.0
ENDINIT

EXEC
  IF (STA > 1.9 OR STB > 1.9 OR STC > 1.9 OR FM > 0.5) THEN
    FM := 1.0
  ENDIF

  GA_P := FM
  GA_N := FM
  GB_P := FM
  GB_N := FM
  GC_P := FM
  GC_N := FM
ENDEXEC
ENDMODEL
