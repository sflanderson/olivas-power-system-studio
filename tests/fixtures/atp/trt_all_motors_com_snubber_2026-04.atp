  LARCr       {DFLT:50e-9}
  CCLOSEDr    {DFLT:0.0}
  COPENr      {DFLT:3e-9}
  CARCr       {DFLT:1e-9}

VAR
  TNOW
  SW_STATEr
  R_VALr
  L_VALr
  C_VALr
  V_CBr
  V_WITHr
  T_AZEROr
  T_ZEROr
  I_PREV
  CB_STATEr
  DI_DTr
  CHOPPEDr
  TIME_PREVr
  T_MSr
  T_SQUAREDr
  VWITHSTANDKVr

INIT
  TNOW := 0.0
  SW_STATEr := 1.0
  R_VALr := RCLOSEDr
  L_VALr := LCLOSEDr
  C_VALr := CCLOSEDr
  V_CBr := 0.0
  V_WITHr := 0.0
  T_AZEROr := 0.0
  T_ZEROr := -1.0
  I_PREV := I_CBr
  CB_STATEr := 0
  DI_DTr := 0.0
  CHOPPEDr := 0
  TIME_PREVr := 0.0
  T_MSr := 0.0
  T_SQUAREDr := 0.0
  VWITHSTANDKVr := 0.0
ENDINIT

EXEC
  TNOW := TNOW + timestep
  V_CBr := V_POSr - V_NEGr

  IF TNOW > TIME_PREVr THEN
    DI_DTr := (I_CBr - I_PREV) / (TNOW - TIME_PREVr)
    TIME_PREVr := TNOW
    I_PREV := I_CBr
  ENDIF

  IF I_PREV * I_CBr <= 0.0 THEN
    IF ABS(I_PREV) > 0.01 THEN
      T_ZEROr := TNOW
      T_AZEROr := 0.0
    ENDIF
  ENDIF

  IF T_ZEROr >= 0.0 THEN
    T_AZEROr := TNOW - T_ZEROr
  ENDIF

  T_MSr := T_AZEROr * 1000.0
  T_SQUAREDr := T_MSr * T_MSr
  VWITHSTANDKVr := RRDS_Ar * T_MSr + RRDS_Br * T_SQUAREDr

  IF TNOW > T_OPENr AND CB_STATEr > 0 THEN
    V_WITHr := VWITHSTANDKVr * 1000.0
  ELSE
    V_WITHr := 0.0
  ENDIF

  IF CB_STATEr = 0 THEN
    IF TNOW >= T_OPENr THEN
      CB_STATEr := 1
      SW_STATEr := 0.0
      R_VALr := RARCr
      L_VALr := LARCr
      C_VALr := CARCr
    ELSE
      R_VALr := RCLOSEDr
      L_VALr := LCLOSEDr
      C_VALr := CCLOSEDr
    ENDIF
  ENDIF

  IF CB_STATEr = 1 THEN
    IF ABS(I_CBr) <= I_CHOPr AND CHOPPEDr = 0 THEN
      CHOPPEDr := 1
      CB_STATEr := 2
      R_VALr := ROPENr
      L_VALr := LOPENr
      C_VALr := COPENr
    ENDIF
    IF ABS(I_CBr) < 0.1 AND T_ZEROr >= 0.0 THEN
      CB_STATEr := 2
      R_VALr := ROPENr
      L_VALr := LOPENr
      C_VALr := COPENr
      CHOPPEDr := 0
    ENDIF
  ENDIF

  IF CB_STATEr = 2 THEN
    IF ABS(V_CBr) > V_WITHr * 1.1 AND V_WITHr > 0.0 THEN
      CB_STATEr := 3
      R_VALr := RARCr
      L_VALr := LARCr
      C_VALr := CARCr
    ENDIF
  ENDIF

  IF CB_STATEr = 3 THEN
    IF ABS(DI_DTr) > DIDT_CRITr * 1.0E6 AND ABS(I_CBr) < 0.1 THEN
      CB_STATEr := 2
      R_VALr := ROPENr
      L_VALr := LOPENr
      C_VALr := COPENr
      CHOPPEDr := 0
    ENDIF
    IF ABS(I_CBr) < 0.1 AND T_ZEROr >= 0.0 THEN
      CB_STATEr := 2
      R_VALr := ROPENr
      L_VALr := LOPENr
      C_VALr := COPENr
      CHOPPEDr := 0
    ENDIF
