# Load (carga industrial / residencial).
# v3.1.1 Sprint 2 — paridade Tutorial PTW §Part 1 p.21-28.
# Distinto de Vac/R (fontes/passivos Qucs) — Load tem kW + kVAR
# + tipo (motor / lighting / heating / mixed) + diversity factor.

schema_version: "1.0"
code: LOAD
label_pt: Carga (Load)
label_en: Load
description: |
  Carga elétrica genérica para análise de fluxo de potência (PF),
  Demand Load (DAPPER NEC 220), curto-circuito (contribuição
  motor) e arc-flash (corrente nominal).

  Modelo PTW:
  * kW + kVAR (PQ load) ou pf + kVA (alternativo)
  * Load type (motor 1ph/3ph, lighting, heating, mixed) — afeta
    DAPPER demand factor (NEC 220.x) e SC contribution.
  * Diversity factor (per-bus) — usado no DAPPER.
  * Per-phase enable — para análise unbalanced (Tutorial §Part 9).

  Cobertura normativa
  ====================
  * NEC 220.x (load calculations) — 22 categorias
  * IEEE 141 (Red Book) §3.5
  * ABNT NBR 5410 (instalações BT)

category: load
atp_supported: false

symbol:
  size: [40, 40]
  bounding_box: [-20, -25, 40, 50]
  renderer: LoadSymbol

pins:
  - name: T1
    label: Phase
    position: [0, -25]

properties:
  - name: tag
    label: TAG
    type: string
    default: LOAD-001
    visible: true
    group: main
    description: Identificador único

  - name: kW
    label: Active power
    unit: kW
    type: float
    default: 100.0
    visible: true
    group: main
    description: Active power demand

  - name: kVAR
    label: Reactive power
    unit: kVAR
    type: float
    default: 60.0
    visible: true
    group: main
    description: |
      Reactive power demand (positive = inductive, lagging).
      For motor loads typical pf=0.85 → kVAR≈0.62×kW.

  - name: voltage_kV
    label: Tensão nominal
    unit: kV
    type: float
    default: 0.480
    visible: true
    group: main
    description: Voltagem L-L da carga

  - name: load_type
    label: Tipo de carga
    type: enum
    default: motor_3ph
    visible: true
    group: main
    choices:
      - motor_1ph
      - motor_3ph
      - lighting
      - heating
      - mixed
      - electronic
    description: |
      Categoria NEC 220 / DAPPER. Afeta:
      * Demand factor (NEC tabela 220.42)
      * SC contribution (motor contribui ao fault, outros não)
      * DAPPER calculator (motor → harmônico fonte typical)

  - name: diversity_factor
    label: Diversity factor
    type: float
    default: 1.0
    visible: false
    group: advanced
    description: |
      DAPPER diversity factor (1.0 = no diversity). Per-bus
      override do Bus Load Diversity Factor (Tutorial §Part 1
      p.52).

  - name: phase_a_enabled
    label: Phase A
    type: bool
    default: true
    visible: false
    group: advanced
    description: |
      Per-phase enable (Tutorial §Part 9 p.241-242). Útil para
      single-phase loads ou análise open-phase scenarios.

  - name: phase_b_enabled
    label: Phase B
    type: bool
    default: true
    visible: false
    group: advanced
    description: Per-phase enable

  - name: phase_c_enabled
    label: Phase C
    type: bool
    default: true
    visible: false
    group: advanced
    description: Per-phase enable

  - name: vendor_model
    label: Vendor / Model
    type: string
    default: ""
    visible: false
    group: advanced
    description: Vendor + modelo (link à EquipmentLibrary)

atp_emission:
  kind: custom
  count: 0
  custom_emitter: load_no_atp

llm_hints:
  typical_applications:
    - Carga concentrada de feeder MV/LV
    - Demand Load Study (DAPPER 22 NEC categorias)
    - Motor load (contribui SC com factor 4× rated)
  references:
    - "PTW Tutorial v8.0 §Part 1 p.21-28, §Part 9 p.241"
    - "NEC 220.x (load calculations)"
    - "IEEE Std 141 (Red Book) §3.5"
    - "ABNT NBR 5410"
  common_mistakes:
    - "kW + kVAR negativos → carga absorvendo reativo (capacitor)"
    - "load_type=motor mas pf>0.95 → revisar (motor real ~0.85)"
    - "diversity_factor=0 → exclui carga do DAPPER"
