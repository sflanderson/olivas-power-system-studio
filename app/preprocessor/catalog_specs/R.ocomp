# Resistor linear — elemento passivo 2-terminal mais básico.
# Corresponde ao cartão ATP TYPE-0 (branch linear) ou linha RLC.

schema_version: "1.0"
code: R
label_pt: Resistor
label_en: Resistor
description: |
  Resistor linear ideal. Gera um cartão ATP de ramo linear
  (R-L-C com L=C=0). Pode ter coeficiente térmico via T_amb
  para estudos de dependência com temperatura (raro em transitórios
  rápidos, útil em estudos térmicos de longa duração).

category: passive
atp_supported: true

symbol:
  size: [40, 60]
  bounding_box: [-20, -30, 40, 60]
  renderer: ResistorSymbol

pins:
  - name: p1
    label: Terminal superior
    position: [0, -30]
  - name: p2
    label: Terminal inferior
    position: [0, 30]

properties:
  - name: R
    label: Resistência
    unit: ohm
    type: float
    default: 1000.0
    visible: true
    group: main
    min: 0.0
    description: Resistência em Ohm
    example: 1000
  - name: T_amb
    label: Temperatura ambiente
    unit: "°C"
    type: float
    default: 26.85
    visible: false
    group: thermal
    description: Temperatura ambiente para correção térmica (K = °C + 273.15)
  - name: model
    label: Estilo do símbolo
    type: enum
    default: european
    visible: false
    group: metadata
    choices: [european, us]
    description: European = retângulo; US = zig-zag (IEEE 315)

atp_emission:
  kind: resistor
  count: 1

llm_hints:
  typical_applications:
    - Representação de resistência de linha concentrada (PI)
    - Amortecimento em circuitos snubber
    - Simulação de resistor de aterramento de neutro
    - Aproximação inicial de carga resistiva
  references:
    - "H. W. Dommel, EMTP Theory Book, BPA, 1986, Ch. 4"
    - "ATP Rule Book, Section I.A"
  common_mistakes:
    - Valor muito baixo (< 1e-3 Ω) pode causar instabilidade numérica
    - Esquecer de usar RNL (não-linear) para resistor com saturação térmica real
    - Confundir com XOPT (resistor de reatância) em cartões antigos
  alternatives:
    - RNL — resistor não-linear R(I)
    - ZnO — para-raios (se comportamento for tipo-92)
