# Fonte de tensão DC ideal — impõe V constante entre seus terminais.

schema_version: "1.0"
code: Vdc
label_pt: Fonte de tensão DC
label_en: DC voltage source
description: |
  Fonte de tensão DC ideal (impedância zero). Gera um cartão TYPE-11
  no cartão ATP (DC source). O nó "+" é o superior e "-" o inferior.

category: source
atp_supported: true

symbol:
  size: [40, 60]
  bounding_box: [-20, -30, 40, 60]
  renderer: VdcSymbol

pins:
  - name: plus
    label: Terminal (+)
    position: [0, -30]
  - name: minus
    label: Terminal (-)
    position: [0, 30]

properties:
  - name: amplitude
    label: Amplitude
    unit: V
    type: float
    default: 12.0
    visible: true
    group: main
    description: Valor DC da fonte (positivo ou negativo)
    example: 12

atp_emission:
  kind: source_dc
  count: 1

llm_hints:
  typical_applications:
    - Baterias e retificadores idealizados
    - Fonte DC para estudos de HVDC (classic)
    - Ramp functions iniciais (combinar com Vrect)
  references:
    - "ATP Rule Book, Section I.C (TYPE-11)"
  common_mistakes:
    - Usar Vdc sem GND leva a tensões relativas indefinidas
    - Amplitude muito alta sem impedância série causa surtos inviáveis
  alternatives:
    - Vrect — DC com rampa inicial
    - Vac com freq=0 (menos preciso)
