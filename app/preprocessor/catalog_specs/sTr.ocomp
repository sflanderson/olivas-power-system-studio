# Transformador 2-enrolamentos simplificado (sem ramo magnetizante).

schema_version: "1.0"
code: sTr
label_pt: Transformador simples
label_en: Simple ideal transformer
description: |
  Transformador ideal (razão fixa, sem saturação, sem ramo
  magnetizante). Para estudos didáticos ou quando o trafo não é o
  foco da análise. Emissão atual: placeholder de branch tipo 19
  com warning.

category: coupled
atp_supported: true

symbol:
  size: [80, 60]
  bounding_box: [-40, -30, 80, 60]
  renderer: TransformerSymbol

pins:
  - name: p1_top
    label: Primário - superior
    position: [-30, -20]
  - name: p1_bot
    label: Primário - inferior
    position: [-30, 20]
  - name: p2_top
    label: Secundário - superior
    position: [30, -20]
  - name: p2_bot
    label: Secundário - inferior
    position: [30, 20]

properties:
  - name: ratio
    label: Razão de transformação
    type: string
    default: "1:1"
    visible: true
    group: main
  - name: L_mag
    label: Indutância magnetizante
    unit: H
    type: string
    default: "1 mH"
    visible: true
    group: electrical

  # v0.24.1: campos de teste BCTRAN. Todos opcionais; se preenchidos,
  # o bridge_to_atp emite cards tipo 51/52 via BCTRAN em vez do
  # placeholder legacy.
  - name: V_H
    label: Tensão nominal H
    unit: V
    type: float
    default: 0.0
    visible: false
    group: electrical
    min: 0.0
    description: Tensão nominal do enrolamento de alta (V rms)
  - name: V_L
    label: Tensão nominal L
    unit: V
    type: float
    default: 0.0
    visible: false
    group: electrical
    min: 0.0
    description: Tensão nominal do enrolamento de baixa (V rms)
  - name: S_nom
    label: Potência nominal
    unit: VA
    type: float
    default: 0.0
    visible: false
    group: electrical
    min: 0.0
    description: Potência aparente nominal (VA)
  - name: v_sc_pct
    label: Z de curto-circuito
    unit: "%"
    type: float
    default: 0.0
    visible: false
    group: electrical
    min: 0.0
    max: 100.0
    description: Impedância percentual (teste SC). 5-15% para potência
  - name: p_sc_kW
    label: Perdas em cobre (SC)
    unit: kW
    type: float
    default: 0.0
    visible: false
    group: electrical
    min: 0.0
    description: Perdas no teste de curto-circuito (Joule nos enrolamentos)
  - name: i_0_pct
    label: Corrente de excitação
    unit: "%"
    type: float
    default: 0.0
    visible: false
    group: electrical
    min: 0.0
    max: 100.0
    description: I_0 no teste OC (típico 0.5-2%)
  - name: p_0_kW
    label: Perdas a vazio (OC)
    unit: kW
    type: float
    default: 0.0
    visible: false
    group: electrical
    min: 0.0
    description: Perdas no núcleo (teste OC)

atp_emission:
  kind: transformer_2w
  count: 1

llm_hints:
  typical_applications:
    - Estudo didático de transformação
    - Adaptação de tensão sem modelar núcleo
  references:
    - "H. W. Dommel, EMTP Theory Book, BPA, 1986, Ch. 6"
  common_mistakes:
    - Não modela saturação — não usar para inrush
  alternatives:
    - Tr — trafo com ramo magnetizante explícito
    - BCTRAN / XFMR (v0.22.2) — trafo com saturação
