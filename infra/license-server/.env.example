# Olivas License Server — exemplo de variáveis (copiar para .dev.vars)

# HMAC secret usado para gerar e validar chaves
# Manter sincronizado com app/commercial/license_key.py::_HMAC_SECRET
# (mas em produção, este valor sobrescreve o dummy do código)
HMAC_SECRET=change-me-to-32-bytes-random

# RS256 keypair para JWT (gerar com openssl genrsa -out priv.pem 2048)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Admin token para endpoint /revoke (header X-Admin-Token)
ADMIN_TOKEN=long-random-string-only-known-to-author

# Supabase
SUPABASE_URL=https://xyz.supabase.co
SUPABASE_SERVICE_KEY=service-role-key-here

# Hotmart webhook validation
HOTMART_HOTTOK=token-from-hotmart-producer-console

# Resend transactional email
RESEND_API_KEY=re_xxx

# Environment
ENVIRONMENT=development
